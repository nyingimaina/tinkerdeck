{
  // How to recognise and adopt an existing Tauri app (kind "tauri"). New code is written to the standard in src-tauri/src/features (the Rust core) and
  // src/features (the window); everything else is the old dialect, left alone and reached through adapters. The Rust format and lint gates judge new code
  // and anything the old code did not already get wrong (a baseline is recorded at adoption).
  "kind": "tauri",
  "tauri": {
    "newCodeRoots": [ "src-tauri/src/features", "src-tauri/src/shared", "src/features", "src/shared" ],
    "gateScript": "tools/rust_gate.mjs",
    "versionsScript": "tools/check-versions.mjs"
  },
  "web": {
    "requireAnyDependency": [ "react", "vite", "typescript", "vue", "svelte", "solid-js", "preact" ],
    "featureNames": [ "src/features", "src" ],
    "sharedNames": [ "src/shared", "src/api", "src/lib" ],
    "testRunners": [
      { "dependency": "vitest", "command": "npx vitest run" },
      { "dependency": "jest", "command": "npx jest" }
    ],
    "runScripts": []
  },
  "ci": {
    "folders": [ ".github/workflows" ],
    "commands": { "web-tests": [ "npm test", "npm run test", "pnpm test", "pnpm run test", "yarn test", "npx vitest" ] }
  },
  "fillableChecks": [ "tauri-web-tests", "tauri-web-typecheck", "tauri-web-build" ],
  "allowedPrograms": [ "npm", "npx", "pnpm", "yarn", "node", "cargo" ],
  "fillTimeoutSeconds": 180,
  "ignoreExtra": [ "**/src-tauri/target/**", "**/src-tauri/gen/**", "**/dist/**", "**/node_modules/**", "**/coverage/**", "**/installer/output/**" ]
}
